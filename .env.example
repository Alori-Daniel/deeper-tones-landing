# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://deepertones.com

# Resend: API key with contacts access, and optional segment to group waitlist sign-ups
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Search engine verification codes (the content value of the meta tag); the tag is only added when set
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Cloudflare Web Analytics token; the beacon script is only added when set (set at build time)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Set to 1 at build time (preview deploys) to include guides marked `draft: true`; they render noindex and stay out of the sitemap
GUIDES_SHOW_DRAFTS=

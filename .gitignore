# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare (OpenNext)
.open-next
.wrangler
.dev.vars*
!.dev.vars.example

# Generated from content/guides/*.md by scripts/build-guides.mjs
/src/content/guides.generated.ts
/src/content/hubs.generated.ts

# Generated from content/figures-src/ by scripts/build-guides.mjs (WebP figures served as static assets)
/public/guides/

# Quality loop: evidence, screenshots and third-party reference images stay local (specs in quality/*.md are committed)
/quality/baseline/
/quality/review/
/quality/inspiration/
/quality/samples/
/quality/art-round2/

# written by CI before each build, so the smoke check can tell which version answered
/public/build.txt
